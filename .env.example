# --- Servidor local (python src/servidor.py) ---
APP_HOST=127.0.0.1
APP_PORT=8000
# Límite de carga, en MB (incluye el pequeño envoltorio de la petición)
MAX_AUDIO_MB=200

# --- Producción (gunicorn -c gunicorn.conf.py / Docker) ---
# PORT lo asigna la plataforma (Render, Railway); tiene prioridad sobre APP_PORT.
# PORT=8000
# Orígenes del frontend autorizados por CORS, separados por comas (sin barra final).
# CORS_ORIGINS=https://voces.vercel.app
# 1 = el backend también sirve la página en «/»; 0 = solo API.
# SERVIR_WEB=1
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=900
